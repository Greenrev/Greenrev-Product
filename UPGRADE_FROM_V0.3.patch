+:where(button){border:1px solid var(--line);border-radius:7px;background:var(--raised);color:var(--text);padding:9px 12px;font-size:12px;max-width:100%}
+:where(input:not([type=checkbox]):not([type=radio]),select,textarea){width:100%;max-width:100%;padding:11px 12px;border:1px solid #35402f;border-radius:6px;background:var(--field);color:var(--text);font-size:13px}
+:where(textarea){min-height:100px;resize:vertical;line-height:1.6}
+:where(.panel-body>label,.public-marketplace>label){display:flex;flex-direction:column;gap:8px;margin:0 0 18px;font-size:12px;color:var(--muted)}
+input::file-selector-button{border:1px solid var(--line);border-radius:5px;background:var(--raised);color:var(--text);padding:7px 10px;margin-right:12px}.tool-tabs button:not(.primary):hover{border-color:var(--lime)}
+.demo-bar label{white-space:nowrap}.demo-bar select{width:auto;min-width:150px}
+@media(max-width:650px){.public-marketplace{padding:1.2rem}.public-marketplace>header{flex-direction:column;align-items:flex-start;gap:1rem;margin-bottom:1.5rem}.public-marketplace .brand{max-width:100%;padding:0}.brand>div{min-width:0}.public-marketplace h1{font-size:27px}.public-listings{grid-template-columns:1fr}}
+@page{size:A4;margin:12mm}
+@media print{:root{color-scheme:light!important}}
+@page{background:#fff}
