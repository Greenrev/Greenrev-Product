+  let invoice = await f.post<ServiceInvoice>('/api/service-invoices', { module: 'RENTAL', job_id: r.id, tax_percent: '5' });
+  const receipt = await f.post('/api/receipts', { invoice_id: invoice.id, amount: '2100', reference: 'PAID-RENT' });
