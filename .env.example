# Standalone review app only. Never enable its demo identities in production.
GREENREV_DEMO=1
# Optional strict address pin. Leave unset to support localhost and 127.0.0.1.
# GREENREV_DEMO_ORIGIN=http://localhost:3100
# GREENREV_DEMO_DB=/absolute/path/greenrev-demo.sqlite
# Host integration only (not consumed by the standalone demo):
# DATABASE_URL=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=https://your-domain.example/billing/return
