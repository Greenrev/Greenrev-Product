new file mode 100644
--- /dev/null
+++ b/scripts/browser-restoration.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import {mkdir,writeFile,readFile} from 'node:fs/promises';
+import {chromium} from 'playwright';
+import {withTestServer} from './test-server.mjs';
+import {deflateSync} from 'node:zlib';
+const checks=[],output=process.env.GREENREV_QA_OUTPUT||'test-results';await mkdir(output,{recursive:true});
+// Valid RGB PNG generated as a test fixture, not a user-facing image artifact.
+function crc(b){let x=0xffffffff;for(const byte of b){x^=byte;for(let i=0;i<8;i++)x=(x>>>1)^(x&1?0xedb88320:0);}return(x^0xffffffff)>>>0;}
+function chunk(name,data){const n=Buffer.from(name),b=Buffer.alloc(12+data.length);b.writeUInt32BE(data.length);n.copy(b,4);data.copy(b,8);b.writeUInt32BE(crc(Buffer.concat([n,data])),8+data.length);return b;}
+const ihdr=Buffer.alloc(13);ihdr.writeUInt32BE(64,0);ihdr.writeUInt32BE(40,4);ihdr[8]=8;ihdr[9]=2;const pixels=Buffer.alloc(40*(1+64*3));for(let y=0;y<40;y++)for(let x=0;x<64;x++){const p=y*193+1+x*3;pixels[p]=163;pixels[p+1]=230;pixels[p+2]=53;}const png=Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]),chunk('IHDR',ihdr),chunk('IDAT',deflateSync(pixels)),chunk('IEND',Buffer.alloc(0))]);
+await withTestServer(async base=>{
+ const browser=await chromium.launch({headless:true,executablePath:process.env.CHROMIUM_EXECUTABLE_PATH||undefined,args:['--no-sandbox','--disable-dev-shm-usage']});
+ try{
+ const page=await browser.newPage({viewport:{width:1440,height:1050}}),errors=[];page.on('pageerror',e=>errors.push(e.message));page.setDefaultTimeout(20000);
+ await page.goto(base,{waitUntil:'networkidle'});await page.locator('.topbar strong').filter({hasText:'Rental company'}).waitFor();const nav=page.locator('.sidebar nav'),profile=page.getByLabel('Demo profile');
